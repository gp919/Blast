# CLAUDE.md 코드 컨벤션을 에디터가 강제하도록 옮긴 파일입니다.
# 규칙 원문은 CLAUDE.md "코드 컨벤션" 절, 근거는 docs/project_context.md 3번 참조.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,asmdef,asmref,inputactions}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Unity가 생성하는 YAML 자산은 사람이 손대지 않습니다. 포매팅 규칙을 걸지 않습니다.
[*.{unity,prefab,asset,mat,anim,controller,meta}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.cs]
indent_size = 4

# --- using 정리 ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# --- var 사용: 우변에서 타입이 자명할 때만 ---
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning

# --- Unity 전용 억제 ---
# UnityEngine.Object 는 == 와 != 를 오버로드해 파괴된 객체를 null 로 취급합니다.
# ?. 와 ?? 와 is null 은 그 오버로드를 거치지 않는 순수 참조 비교라, 파괴된
# 오브젝트에서 null 이 아닌 것으로 판정됩니다. 아래 제안들은 따르면 버그가 됩니다.
dotnet_diagnostic.IDE0029.severity = none
dotnet_diagnostic.IDE0030.severity = none
dotnet_diagnostic.IDE0031.severity = none
dotnet_diagnostic.IDE0041.severity = none

# --- 중괄호와 배치 ---
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

# --- this. 접두사 금지. private 필드는 밑줄로 구분되므로 불필요 ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- 접근 한정자 명시 ---
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# =====================================================================
# 명명 규칙
# 규칙은 위에서부터 순서대로 평가되고 처음 일치한 것이 적용됩니다.
# 따라서 좁은 규칙(상수, private 필드)을 넓은 규칙보다 먼저 둡니다.
# =====================================================================

# 스타일 정의
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed_pascal_case.required_prefix = I

# 1. 인터페이스는 I 접두사
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed_pascal_case
dotnet_naming_rule.interfaces_are_i_prefixed.severity = warning

# 2. 상수는 PascalCase (private const 포함이므로 private 필드 규칙보다 먼저)
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

# 3. private 및 protected 필드는 _camelCase
#    [SerializeField] private 도 여기에 포함됩니다
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, private_protected

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

# 4. 지역 변수와 파라미터는 camelCase
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_rule.locals_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel_case.style = camel_case
dotnet_naming_rule.locals_are_camel_case.severity = warning

# 5. 그 외 타입과 멤버는 PascalCase
dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, property, method, event, field
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning
